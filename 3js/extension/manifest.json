{
  "manifest_version": 3,
  "name": "ESPN Bottom Line Overlay",
  "version": "1.0.0",
  "description": "Overlays a live ESPN-style sports ticker at the bottom of every page you browse.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://site.api.espn.com/*",
    "https://www.fantrax.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
